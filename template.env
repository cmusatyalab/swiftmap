# SwiftMap server settings -- every environment variable the server reads.
#
#   cp template.env .env                              # then edit .env (git-ignored)
#   uv run --env-file .env python launch_server.py
#   docker run --env-file .env ...                    # paths must be container paths
#
# Under SteelEagle these come from steeleagle's backend/server/.env instead.
#
# A commented-out line shows the default used when the variable is unset. Never leave
# one set but empty: several are parsed as numbers. Comments stay on their own lines,
# because `docker run --env-file` keeps an inline "# ..." as part of the value.

# --- Server (each also has a launch_server.py flag, which wins) ----------------------

# Bind address for the TCP ingest and the viewer.
# SWIFTMAP_HOST=0.0.0.0
# TCP ingest port.
# SWIFTMAP_PORT=43322
# Reconstruction backbone: vggt | vggt_omega.
# SWIFTMAP_BACKBONE=vggt_omega
# Segmentation backend.
# SWIFTMAP_SEGMENTER=sam3
# Keyframes per map; the pipeline runs each time a batch fills.
# SWIFTMAP_BATCH_SIZE=25
# Keyframe selection: minimum mean optical-flow disparity, in pixels.
# SWIFTMAP_MIN_DISPARITY=40
# Where maps and the site are stored.
# SWIFTMAP_OUTPUT_DIR=output
# Results viewer port.
# SWIFTMAP_VIEWER_PORT=7866

# --- VGGT-Omega ----------------------------------------------------------------------

# Checkpoint (.pt). Required for the vggt_omega backbone: it has no hub download.
VGGT_OMEGA_CHECKPOINT=/path/to/vggt_omega_1b_512-002.pt
# Input resolution; must match the checkpoint.
# VGGT_OMEGA_IMAGE_RESOLUTION=512

# --- SAM 3 ---------------------------------------------------------------------------

# Local checkpoint. Unset downloads facebook/sam3 from Hugging Face, which is gated:
# that needs a token from an account whose access request was approved.
SAM3_CHECKPOINT=/path/to/sam3.pt
# Tokenizer vocab. Unset uses the copy the sam3 package ships.
# SAM3_BPE_PATH=/path/to/bpe_simple_vocab_16e6.txt.gz
# Minimum instance confidence for a mask to count.
# SAM3_CONF_THRESHOLD=0.5

# --- Next Flight Navigation ----------------------------------------------------------

# Cap on suggested viewpoints per plan.
# NFN_MAX_VIEWPOINTS=10
